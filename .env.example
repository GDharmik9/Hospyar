# Environment Configuration
ENV=development
DEBUG=True
APP_NAME="Hospyar Sovereign AI Copilot"
VERSION=1.0.0-PROD

# Sovereign Cloud & GCC Compliance
SOVEREIGN_REGION=UAE-CENTRAL-1
REGULATORY_REGIME=UAE_PDPL_LAW_45

# Snowflake CoCo CLI & Governed Boundary
SNOWFLAKE_ACCOUNT=HOSPYAR_GCC_PROD
SNOWFLAKE_USER=HOSPYAR_DEV_USER
SNOWFLAKE_PASSWORD=replace-with-your-snowflake-password
SNOWFLAKE_DATABASE=HOSPYAR_PATIENT360_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=HOSPYAR_CLINICAL_WH
SNOWFLAKE_ROLE=HOSPYAR_CLINICAL_ROLE

# Cortex AI Managed LLM
CORTEX_MODEL=llama3.3-70b

# Security Secrets & Salt
JWT_SECRET_KEY=replace-with-sovereign-production-jwt-secret
JWT_ALGORITHM=HS256
AUDIT_SALT=replace-with-sha256-audit-secret-salt

# Frontend Port & API Base
VITE_API_URL=http://localhost:8000/api/v1
PORT=5173
